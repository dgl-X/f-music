[Unit]
Description=Family Music background worker
After=network.target postgresql.service family-music.service
Requires=postgresql.service family-music.service

[Service]
Type=simple
User=family-music
Group=family-music
WorkingDirectory=/opt/family-music
EnvironmentFile=/opt/family-music/.env
ExecStartPre=/usr/bin/node /opt/family-music/src/wait-for-api.js
ExecStart=/usr/bin/node /opt/family-music/src/server.js --worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/opt/family-music/storage

[Install]
WantedBy=multi-user.target
