{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-music.example/schemas/federation/delta-v1.schema.json",
  "title": "Family Music catalog delta page v1",
  "type": "object",
  "required": ["protocol_version", "producer_minor", "min_reader_minor", "items", "next_cursor"],
  "properties": {
    "protocol_version": {"const": 1},
    "producer_minor": {"type": "integer", "minimum": 0},
    "min_reader_minor": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["revision", "type", "event_version", "critical", "origin_id", "object_id", "occurred_at", "payload"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*\\.v[1-9][0-9]*$"},
          "event_version": {"type": "integer", "minimum": 1},
          "critical": {"type": "boolean"},
          "origin_id": {"type": "string", "pattern": "^fm:[A-Za-z0-9_-]{16,128}$"},
          "object_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "occurred_at": {"type": "string", "format": "date-time"},
          "payload": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "next_cursor": {"type": ["string", "null"], "maxLength": 4096},
    "has_more": {"type": "boolean"}
  },
  "additionalProperties": true
}
